# SentinelRecon Configuration File
# Copy this to .env and fill in your API keys

# Claude API Configuration
CLAUDE_API_KEY=your_claude_api_key_here

# OpenAI API Configuration (optional alternative to Claude)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo

# NVD API Configuration (optional but recommended for CVE lookups)
NVD_API_KEY=your_nvd_api_key_here

# Threat Intelligence Configuration
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
SHODAN_API_KEY=your_shodan_api_key_here

# Database Configuration
DATABASE_PATH=~/.sentinelrecon/sentinel.db
LOG_PATH=~/.sentinelrecon/logs/sentinel.log

# Application Settings
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Scan Defaults
DEFAULT_SCAN_TIMEOUT=5
DEFAULT_THREAD_COUNT=10
DEFAULT_PORTS=1-1024

# AI Provider (claude or openai)
AI_PROVIDER=claude

# Beginner Mode (True for simplified explanations)
BEGINNER_MODE=True

# ==========================================
# Cloud Provider Configurations (SentinelRecon v2.0)
# ==========================================
# AWS Configuration
AWS_PROFILE=your-aws-profile
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# Azure Configuration
AZURE_SUBSCRIPTION_ID=your-subscription-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret
# AZURE_TENANT_ID=your-tenant-id

# GCP Configuration
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/your/gcp-service-account-key.json
